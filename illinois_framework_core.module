<?php

/**
 * Implements hook_theme().
 */
function illinois_framework_core_theme() {
  return array(
    'media_remote_illinois_mediaspace' => array(
      'variables' => array(
        'url' => NULL,
        'width' => NULL,
        'height' => NULL,
      ),
    ),
  );
}
/**
 * @file
 * Primary module hooks for Illinois Framework Core.
 */

/**
 * Implements hook_requirements_alter().
 *
 * Adds an "Illinois Framework" card to the General System Information
 * section of the status report page (admin/reports/status), showing the
 * installed version of the core module, theme, and install profile. The
 * "Custom Status Report" module (a dependency of this module) is what
 * actually renders any requirement flagged with 'add_to_general_info' as a
 * card in that section.
 */
function illinois_framework_core_requirements_alter(array &$requirements): void {
  $profile_info = \Drupal::service('extension.list.profile')->getExtensionInfo(\Drupal::installProfile());
  $module_info = \Drupal::service('extension.list.module')->getExtensionInfo('illinois_framework_core');
  $theme_info = \Drupal::service('extension.list.theme')->getExtensionInfo('illinois_framework_theme');

  $requirements['illinois_framework'] = [
    'title' => t('Illinois Framework'),
    'value' => [
      '#theme' => 'item_list',
      '#items' => [
        t('Profile: @version', ['@version' => $profile_info['version'] ?? t('Unknown')]),
        t('Core: @version', ['@version' => $module_info['version'] ?? t('Unknown')]),
        t('Theme: @version', ['@version' => $theme_info['version'] ?? t('Unknown')]),
      ],
    ],
    'severity' => REQUIREMENT_OK,
    'add_to_general_info' => TRUE,
  ];
}

/**
 * Implements hook_preprocess_field().
 */
function illinois_framework_core_preprocess_field(&$variables) {
  $variables['node'] = $variables['element']['#object'];
}

/**
 * Implements hook_config_schema_info_alter().
 *
 * The imagick module lets editors set a target "format" and "quality" on the
 * core "Convert" (image_convert) image effect, but ships no schema for those
 * keys. Core's image.effect.image_convert only defines "extension", so image
 * styles using this effect report "missing schema" for data.format and
 * data.quality. Add the keys here (rather than redefining the type in a schema
 * file) so the change reliably applies regardless of module load order.
 */
function illinois_framework_core_config_schema_info_alter(&$definitions) {
  if (isset($definitions['image.effect.image_convert']['mapping'])) {
    $definitions['image.effect.image_convert']['mapping'] += [
      'format' => [
        'type' => 'string',
        'label' => 'Format',
      ],
      'quality' => [
        'type' => 'string',
        'label' => 'Quality',
      ],
    ];
  }
}
